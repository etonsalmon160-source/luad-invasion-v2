# 大文件 / 数据：不入库（用软链或 DVC）
data/
data_links/
results/**/*.rds
results/**/*.h5*
results/**/*.mtx*
results/**/*.tar
results/**/*.gz
# 派生的稀疏矩阵二进制（可由 02_expression/01_build_expression_gse308103.py 从原始 .txt.gz 重建）
# 漏掉这两条会让 git add 吞下 1.7 GB（单个 P24_LUAD.npz 即 183 MB，超 GitHub 100 MB 上限）
results/**/*.npz
results/**/*.npy
*.rds
*.h5ad
*.h5
*.npz
*.npy
*.tar
*.tar.gz
*.zip
*.loom

# 运行日志/缓存
logs/
__pycache__/
*.pyc
.Rhistory
.RData
.DS_Store

# 环境（大）
env/

# 第三方工具源码（可随时重新克隆，见 tools/README.md）
tools/

# ── 大体积可重建产物（2026-09-16 补）────────────────────────────────────────
# 漏洞：上面的规则覆盖 *.gz/*.rds/*.h5*/*.npz/*.npy，但 **没有覆盖 *.bin 与 CopyKAT 的
# 逐细胞文本转储**。补漏前 `git add results/` 会吞下 ~20 GB，其中十余个文件 >100 MB，
# push 会被 GitHub 硬拒（单文件上限 100 MB）。均为脚本可重建物，不入库。
results/**/*.bin
results/**/*_copykat_*_by_cell.txt
results/**/cell_names.txt
results/**/embeddings/

# 例外：GP4/GP5 的正式产物虽是 .gz，但体积小（全量约 4–6 MB）且是 GP5 签字的依据 ⇒ 必须入库。
# 必须写在 `results/**/*.gz` 之后，否则被后者覆盖。
!results/04_integration/seurat_trad/*/clusters.csv.gz
!results/04_integration/seurat_trad/*/umap.csv.gz

# ── 例外 2：GP6 逐细胞标签（2026-09-17 PR 前复核补）──────────────────────────
# `00_build_lineage_subsets.py` 的**唯一输入**就是这个文件 —— 六个谱系的冻结清单
# （`*_subset_barcodes.txt`，已入库且带 sha256）全部由它切出。不入库 ⇒ 克隆后无法复现那六份
# 已冻结的清单，「清单哈希」这条溯源链就断在这里。7.5 MB，值得存。
# ⚠️ `gp6_scores.csv.gz`（26 MB，标准 A 的逐细胞模块分）**故意不在此列**：它是标签的**证据**、
#    不是任何已入库脚本的输入，且重跑 `01_dual_standard_annotation.py` 即可再生。
!results/05_annotation/gp6_cell_labels.csv.gz

# ── 例外 3：P24 环境 RNA 检验的逐细胞表（2026-09-22）─────────────────────────
# `08_p24_ambient_ig_test.py` 的 manifest 直接引用这张表；而它的上游 h5ad
# （`gse308103_counts_paperqc.h5ad`）**本身不入库**，重建要先跑完整个表达对象重建。
# 为了「P24 是否单列/加环境校正」这个待决问题可被独立复核，8.2 MB 值得存。
!results/05_annotation/p24_ambient_ig_cells.csv.gz

# ── 崩溃前基线（2026-09-17）──────────────────────────────────────────────────
# `.prev_nomanifest/` 是 subset 首跑崩在最后一行时留存下来的**验证脚手架**，用于比对重跑
# 是否逐字节一致。核对已完成（4/6 谱系三项产物 md5 全同，值已登记在
# docs/PARAMETERS_AND_SOURCES.md §M3-A.5）。它**不是交付物**：86 MB，且其中 clusters/umap
# 与正式产物同源、embeddings 可由脚本重建。⇒ 明确不入库，本地保留备查，可随时删。
results/04_integration/seurat_trad/.prev_nomanifest/

# ── 指标3 换 r* 前的旧产物（2026-09-22）─────────────────────────────────────
# L1 口径切到 `A_adjudicated` 后，上皮/T·NK/内皮 三个谱系的 `r*` 变了，而
# `metric3_coverage.csv` 是按「各对象自己的 r*」那几行取头条的 ⇒ 旧产物中的
# `r*` 处数值已不成立。重跑 `05_annotation/04_metric3_coverage.py` 得到现行版本，
# 旧三份留在此处备查（sha256 见 docs/PARAMETERS_AND_SOURCES.md §M3-A.3）。
# 不入库：它由脚本可完全再生，且现行版本已在库内。
results/05_annotation/.prev_metric3_20260921/

# ── 旧口径产物备份（2026-09-22 L1 口径切换前）───────────────────────────────
# `_superseded/` 存的是 `A_frozen` 口径下被 `A_adjudicated` 取代的那一整套产物
# （subset barcodes + seurat_trad 各谱系），仅作**本地比对/回溯**用。171 MB，且
# 全部可由脚本在旧口径下再生 ⇒ **不入库**（与 `.prev_nomanifest/` 同一处置）。
# ⚠️ 任何文档都**不得**把 `results/_superseded/` 当哈希锚点引用。
results/_superseded/

# ── 临时脚手架（scratch）──────────────────────────────────────────────────
# 一次性诊断脚本与外部数据落地（含 90 MB 的 `GSM9226176` 空间 tar）。**不是交付物**，
# 其中已验证可用的脚本应在定稿后再迁入正式目录（如 `04_integration/`）。
scratch/

# ── infercnv 产物 + 模型权重（2026-09-24 补）───────────────────────────────
# 漏洞：前面覆盖了 .gz/.rds/.h5*/.npz/.npy/.bin，但 **不认识 infercnv 的产物格式**。
# `results/03_cnv/infercnv_smoke/infercnv_out/` 与 `..._ABORTED_dgeMatrix/` 合计 20.4 GB，
# 其中 **24 个文件 >100 MB**（最大 `expr.infercnv.preliminary.dat` 2.5 GB）——
# 一次 `git add -A` 就会把 20.6 GB 全部暂存，push 被 GitHub 按单文件 100 MB 上限硬拒。
# 这些都是 `16_run_infercnv_smoke.R` 可重建的中间对象（表达矩阵 / 逐步调参快照 / 参考与
# 观测表）⇒ 不入库。**保留**同目录的 3 张 .png 与 6 个 <1 MB 的 groupings/thresholds 文本，
# 它们是小体积的结论证据，所以这里按**文件名**排除而不是整目录排除
# （gitignore 无法在整目录排除后重新包含其中的文件）。
results/**/*.infercnv_obj
results/**/expr.infercnv*.dat
results/**/infercnv.*observations.txt
results/**/infercnv.*references.txt

# 模型权重：PLIP 的 `pytorch_model.bin` 单文件 577 MB，可由 hf-mirror 重新下载
# （见 docs 里的模型来源），且是 HF 目录布局 ⇒ 不入库。
# **保留**同目录的 config.json / tokenizer.json 等小文件：它们是「用的哪个模型、
# 哪个版本」的凭证，没有它们无法复现 04/11 两个打分脚本。
models/**/*.bin
models/**/*.safetensors
models/**/*.pt
models/**/*.pth
models/**/*.ckpt
models/**/*.onnx
models/**/.cache/

# ── H&E 分辨率/源审计的脚手架（2026-09-24）─────────────────────────────────
# 审计过程产物：`resolution_sweep/` 目录 258 MB 里绝大多数是逐张切片的诊断图
# （`reg8_*`/`reg9_*`/`ver7_*`/`focus_*`/`checker_*` ...）与 `_tmp_*.py` 一次性脚本。
# 结论已固化为库内的 CSV/JSON/MD 与少数几张图 ⇒ 其余不入库，本地留档备查。
07_he_pathology/_tmp_*.py
07_he_pathology/_pp_*
07_he_pathology/*.log
results/07_he_pathology/resolution_sweep/*.png
# 例外：这三张是结论的证据图，体积小且 PR/文档直接引用（必须写在上一行之后）。
!results/07_he_pathology/resolution_sweep/spectrum_cyto_vs_hires.png
!results/07_he_pathology/resolution_sweep/registration_all56_checker.png
!results/07_he_pathology/resolution_sweep/aligned_detail.png
# `embeds/` 是逐切片的 PLIP 嵌入 .npy。上面 `results/**/*.npy` 其实已覆盖，
# 但它是**目录**而非文件、且目录名是 `embeds/` 不是 `embeddings/`（那条不匹配）
# ⇒ 两条并列，防止将来有人改了扩展名就漏掉。
results/07_he_pathology/resolution_sweep/embeds/
# （`resolution_sweep/per_slide/*/` 里的逐 spot 分数是 `.csv.gz`，已被上面
#   `results/**/*.gz` 挡住，无需另列。）
# 逐张切片的抛光中间日志（`registration_final.csv` 已含最终值）
results/07_he_pathology/resolution_sweep/_polish*.csv
# 四臂对照的分片中间产物：合并后的 `plip_source_arms.csv` 才是交付物
results/07_he_pathology/source_arms/_arms_*.csv
results/07_he_pathology/source_arms/cyto_raw.png
results/07_he_pathology/source_arms/armdump_GSM9226185_P8_LUAD.png
# `registration_56_summary.csv`（v7 抛光**之前**的配准汇总）**故意不入库**：
# 它的 `s` 是抛光前的旧值（P25 0.9733 / P15 1.4312 / P5 1.4963），抛光后已被
# `resolution_sweep/registration_final.csv` 取代（s/s_pred 收敛到 0.995–1.000）。
# 两者并存会让同一张切片出现两个互相矛盾的尺度数 ⇒ 只留最终版。
results/07_he_pathology/registration_56_summary.csv

